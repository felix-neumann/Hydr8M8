<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Google One): back up the database and settings, restore on new devices. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
