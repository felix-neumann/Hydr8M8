<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#3FA7FF</color>
    <color name="window_background">#F4F9FE</color>

    <style name="Theme.Hydr8M8" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Invisible activity for launcher shortcuts. -->
    <style name="Theme.Hydr8M8.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
</resources>
